{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diaspor",
  "version": "2.0.7",
  "identifier": "io.diaspor.vfs",
  "build": {
    "beforeDevCommand": "npx vite --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Diaspor",
        "label": "main",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "zoomHotkeysEnabled": true,
        "url": "index.html",
        "devtools": true,
        "visible": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://localhost:* https://api.ursly.io https://auth.ursly.io https://grpc.ursly.io https://*.ursly.io; connect-src 'self' tauri: http://localhost:* ws://localhost:* https://api.ursly.io https://auth.ursly.io https://grpc.ursly.io https://*.ursly.io wss://*.ursly.io wss://api.ursly.io; script-src 'self' 'unsafe-inline' 'unsafe-eval' tauri: http://localhost:* https://*.ursly.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com http://localhost:*; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob: tauri: asset:; frame-src 'self' http://localhost:* https://auth.ursly.io",
      "capabilities": ["main"]
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/stonyp90/diaspor/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1NTA3Q0E5QTVFMTYxNjIKUldSaVllR2xxWHhRQlpzTTRyVVE3clZpN2RWZUx5czc4Wi9KTDVKQjRUOHlnVkVOTFMrY2gyZlYK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Non-verbal AI for security and legal teams",
    "longDescription": "Diaspor — self-hosted non-verbal AI for Canadian security and legal teams. Hosted in Canada, Loi 25 and PIPEDA aligned.",
    "copyright": "2026 Diaspor inc.",
    "publisher": "Diaspor inc.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "exceptionDomain": null,
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "resources": ["dmg-resources/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
