{
  "name": "@diaspor/sdk",
  "version": "0.1.0-alpha.1",
  "description": "Official TypeScript client SDK for the Diaspor non-verbal video AI API.",
  "license": "Apache-2.0",
  "author": "Anthony Paquet <anthony@diaspor.io>",
  "homepage": "https://diaspor.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stonyp90/diaspor.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/stonyp90/diaspor/issues"
  },
  "keywords": [
    "diaspor",
    "video-ai",
    "pose-estimation",
    "face-mesh",
    "prosody",
    "credibility",
    "sport-judging",
    "whip",
    "webrtc",
    "meeting-bot"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
